# =====================================================================
# Configuration for Themis Project v2.0
# =====================================================================

# Режим работы LLM:
# - "gemini"     : Использовать Google Gemini API (рекомендуется при отсутствии локальной GPU)
# - "mock"       : Детерминированный оффлайн-режим для демонстрации без API-ключей
# - "local_qwen" : Локальный сервер vLLM / llama-server с моделями Qwen3.5
# - "cloud"      : Любой другой OpenAI-совместимый провайдер
LLM_MODE=gemini

# Флаг принудительного открытия окна расписания для демонстрации MVP
SCHEDULE_FORCE_OPEN=true
SCHEDULE_WINDOW_MINUTES=45

# =====================================================================
# GOOGLE GEMINI API (Вставьте ваш ключ API)
# Получить бесплатный ключ можно на: https://aistudio.google.com/app/apikey
# =====================================================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# =====================================================================
# Опциональные настройки для локальной Qwen3.5 (если появится GPU)
# =====================================================================
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_API_KEY=empty
QWEN_DIALOG_MODEL=Qwen/Qwen3.5-4B
QWEN_AUDIT_MODEL=Qwen/Qwen3.5-27B

# =====================================================================
# Параметры психометрического ядра ThemisMathEngine
# =====================================================================
TARGET_TURNS=3
DENSITY_ALPHA=3.5
DENSITY_FLOOR=0.75
INITIATIVE_BONUS=1.0
SIGMA_MIN=4.0
